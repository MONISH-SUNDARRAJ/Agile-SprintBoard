# Copy to .env and change values
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./sprintboard.db
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_MINUTES=60
# Background job
OVERDUE_CHECK_MINUTES=5
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_SECONDS=2
# Demo only: probability (0-1) that a delivery fails, to show retries
DELIVERY_FAIL_RATE=0
